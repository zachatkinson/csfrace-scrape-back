              "id": "CVE-2022-27943",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "binutils: libiberty/rust-demangle.c in GNU GCC 11.2 allows stack exhaustion in demangle_const"
              },
              "fullDescription": {
