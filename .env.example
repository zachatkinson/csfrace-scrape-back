# CSF Race Scraper - Environment Configuration
# Copy this file to .env and update the values for your environment

# Database Configuration (PostgreSQL 17.6)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scraper_db
DATABASE_USER=scraper_user
DATABASE_PASSWORD=scraper_password

# Redis Configuration (for caching and job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Scraper Configuration
MAX_CONCURRENT_SCRAPERS=10
DEFAULT_TIMEOUT=30
MAX_RETRIES=3
REQUEST_DELAY=1.0

# Output Configuration
DEFAULT_OUTPUT_DIR=./converted_content
CREATE_ARCHIVES=false
CLEANUP_AFTER_ARCHIVE=false

# Monitoring (future use)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS Configuration
# Development: Frontend dev servers
# Production: Your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321
# Example for production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# OAuth SSO Configuration (optional - only needed if using OAuth providers)
# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft OAuth
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Facebook OAuth
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Apple OAuth
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# OAuth Token Encryption (OPTIONAL - defaults to test key if not set)
# STRONGLY RECOMMENDED for production deployments to use a unique, secure key
# This key is used to encrypt OAuth access tokens before storing them in the database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: CO26D_Qbr6iZUvEkpFadefnOxCM83ny7Qs7IskL9PRs=
# Leave empty for development/testing (uses default test key automatically)
OAUTH_TOKEN_ENCRYPTION_KEY=

# OAuth Redirect URI Base
OAUTH_REDIRECT_URI_BASE=http://localhost:8000